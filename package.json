{
  "name": "github-showcase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:site": "pnpm --filter @showcase/site dev",
    "dev:agent": "pnpm --filter @showcase/agent dev",
    "start:site": "pnpm --filter @showcase/site start",
    "start:agent": "pnpm --filter @showcase/agent start",
    "build": "pnpm -r build",
    "sync": "node scripts/sync-pages.mjs",
    "migrate-slugs": "node scripts/migrate-slugs.mjs",
    "rerender-diagrams": "node scripts/rerender-diagrams.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.545",
    "@remotion/renderer": "^4.0.545",
    "better-sqlite3": "^13.2.0",
    "msedge-tts": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.24.0"
}
