# === 必填（AI 分析与对话）===
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：私有化部署时改此地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# === 可选（GitHub 抓取限流提升）===
# 不配置也可用，但每小时仅 60 次 GitHub API 请求
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# === 可选（视频/SEO）===
# TTS_VOICE=zh-CN-YunxiNeural
# SITE_URL=http://localhost:3100

# === 可选（站点公开地址，用于 metadataBase 与 OpenGraph 绝对链接）===
# 不配置时 metadataBase 默认为 http://localhost:3100
# NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# === 管理接口鉴权 ===
# 管理接口令牌，Agent 控制台前端请求需携带此 header（x-admin-token）；不配置则管理接口一律拒绝（503）
ADMIN_TOKEN=

# === 应用模式 ===
# all（默认）：完整版，含 Agent 控制台 / 分析 / 对话（本地私有部署）
# public：对外展示的独立部署，隐藏 Agent 能力面（/chat 与相关 API 返回 404，视频渲染 POST 404，内容管理接口保留）
# APP_MODE=all

# === monorepo 路径（可选）===
# 数据库目录（showcase.db 所在）。不配置时自动定位仓库根 data/；Docker 部署设为 /app/data
# DATA_DIR=/absolute/path/to/data
# 共享产物目录（videos / diagrams）。不配置时默认仓库根 public/；Docker 部署设为 /app/public
# PUBLIC_ASSETS_DIR=/absolute/path/to/public
